{
  "name": "pixi-charts",
  "version": "0.0.0",
  "description": "A WebGL-rendered TypeScript charting library built on PixiJS and D3 submodules. Designed for 60fps on 100k+ data points.",
  "license": "MIT",
  "author": "Siraj Sharma",
  "homepage": "https://github.com/sirajsharma/pixi-charts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirajsharma/pixi-charts.git"
  },
  "bugs": {
    "url": "https://github.com/sirajsharma/pixi-charts/issues"
  },
  "keywords": [
    "charts",
    "charting",
    "visualization",
    "pixi",
    "pixijs",
    "webgl",
    "d3",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "pixi.js": "^8.0.0"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-color": "^3.1.0",
    "d3-format": "^3.1.0",
    "d3-quadtree": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-shape": "^3.2.0",
    "d3-time-format": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-color": "^3.1.3",
    "@types/d3-format": "^3.0.4",
    "@types/d3-quadtree": "^3.0.6",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-scale-chromatic": "^3.0.3",
    "@types/d3-shape": "^3.1.6",
    "@types/d3-time-format": "^4.0.3",
    "happy-dom": "^15.7.4",
    "pixi.js": "^8.5.1",
    "tsup": "^8.3.0",
    "typedoc": "^0.26.10",
    "vite": "^8.0.14",
    "vitest": "^2.1.3"
  }
}
